{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "UNFALLX private original photo and PDF storage in Frankfurt. No public access; runtime has only scoped object permissions. No access keys in this template.",
  "Parameters": {
    "BudgetEmail": {
      "Type": "String",
      "Default": "info@unfallx.com"
    },
    "MonthlyBudgetUSD": {
      "Type": "Number",
      "Default": 10,
      "MinValue": 1
    }
  },
  "Rules": {
    "FrankfurtOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "eu-central-1"
            ]
          },
          "AssertDescription": "Create this stack only in Frankfurt (eu-central-1)."
        }
      ]
    }
  },
  "Resources": {
    "Originals": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "unfallx-originals-${AWS::AccountId}-eu-central-1"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "RemoveNoncurrentVersionsAfter30Days",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "RemoveExpiredDeleteMarkers",
              "Status": "Enabled",
              "Expiration": {
                "ExpiredObjectDeleteMarker": true
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "UNFALLX"
          },
          {
            "Key": "Data",
            "Value": "Private originals"
          }
        ]
      }
    },
    "OriginalsPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Originals"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyPlainHttp",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::Sub": "${Originals.Arn}"
                },
                {
                  "Fn::Sub": "${Originals.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "RequireEncryptedOriginals",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Originals.Arn}/originals/*"
              },
              "Condition": {
                "StringNotEquals": {
                  "s3:x-amz-server-side-encryption": "AES256"
                }
              }
            }
          ]
        }
      }
    },
    "RuntimeUser": {
      "Type": "AWS::IAM::User",
      "Properties": {
        "UserName": "unfallx-hostinger-storage",
        "Tags": [
          {
            "Key": "Application",
            "Value": "UNFALLX"
          }
        ],
        "Policies": [
          {
            "PolicyName": "PrivateOriginalsOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject",
                    "s3:DeleteObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Originals.Arn}/originals/*"
                  },
                  "Condition": {
                    "Bool": {
                      "aws:SecureTransport": "true"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "MonthlyBudget": {
      "Type": "AWS::Budgets::Budget",
      "Properties": {
        "Budget": {
          "BudgetName": "UNFALLX monthly AWS alert",
          "BudgetType": "COST",
          "TimeUnit": "MONTHLY",
          "BudgetLimit": {
            "Amount": {
              "Ref": "MonthlyBudgetUSD"
            },
            "Unit": "USD"
          }
        },
        "NotificationsWithSubscribers": [
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "ACTUAL",
              "Threshold": 50,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          },
          {
            "Notification": {
              "ComparisonOperator": "GREATER_THAN",
              "NotificationType": "ACTUAL",
              "Threshold": 100,
              "ThresholdType": "PERCENTAGE"
            },
            "Subscribers": [
              {
                "SubscriptionType": "EMAIL",
                "Address": {
                  "Ref": "BudgetEmail"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "Bucket": {
      "Value": {
        "Ref": "Originals"
      }
    },
    "Region": {
      "Value": {
        "Ref": "AWS::Region"
      }
    },
    "Account": {
      "Value": {
        "Ref": "AWS::AccountId"
      }
    },
    "RuntimeUser": {
      "Value": {
        "Ref": "RuntimeUser"
      }
    },
    "Reminder": {
      "Value": "Create one access key for the scoped runtime user and store it only in Hostinger private environment variables. Budget emails are alerts, not a spending cap."
    }
  }
}
