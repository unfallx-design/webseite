# UNFALLX – Konfiguration des Anfrageformulars
# Diese Werte in Hostinger (hPanel > Node.js-App > Umgebungsvariablen) setzen.
# Niemals echte Zugangsdaten in das Repository schreiben.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@unfallx.com
SMTP_PASS=
MAIL_TO=info@unfallx.com
MAIL_FROM=info@unfallx.com
ANFRAGE_LIMIT=8


# UNFALLX Connect: private MySQL database, retained across deployments
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
PORTAL_ORIGIN=https://unfallx.com
PORTAL_ADMIN_EMAIL=info@unfallx.com
PORTAL_STORAGE_MB=750
# Enable only behind the trusted Hostinger reverse proxy.
PORTAL_TRUST_PROXY=false

# Optionale Anbieter-Anmeldung. Leer = im Login als noch nicht verfügbar markiert.
# Google OAuth-Clienttyp: Webanwendung; Rücksprungadresse exakt:
# https://unfallx.com/api/portal/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Services ID + zugehörige Primary App ID mit Sign in with Apple.
# Rücksprungadresse: https://unfallx.com/api/portal/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Privater .p8-Schlüssel, PEM; echte Zeilenumbrüche oder literale \n möglich.
APPLE_PRIVATE_KEY=
